{
  "name": "animaquill-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "scripts": {
    "dev": "pnpm --filter @animaquill/ui dev",
    "start": "pnpm --filter animaquill start",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "e2e": "pnpm --filter @animaquill/ui --filter @animaquill/scene --filter animaquill --workspace-concurrency=1 e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  }
}
