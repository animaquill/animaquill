{
  "name": "animaquill",
  "version": "0.0.0",
  "description": "AnimaQuill 视频编辑器，在自己的电脑上用 Chrome 或 Edge 打开",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/animaquill/animaquill.git",
    "directory": "packages/local"
  },
  "type": "module",
  "bin": {
    "animaquill": "dist/cli.js"
  },
  "files": [
    "dist",
    "types",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.6.0-beta.19",
    "@embedded-postgres/darwin-x64": "18.6.0-beta.19",
    "@embedded-postgres/linux-arm64": "18.6.0-beta.19",
    "@embedded-postgres/linux-x64": "18.6.0-beta.19",
    "@embedded-postgres/windows-x64": "18.6.0-beta.19"
  },
  "keywords": [
    "video-editor",
    "animation"
  ],
  "scripts": {
    "build": "vite build --config vite.server.config.ts && vite build",
    "start": "pnpm build && node dist/cli.js",
    "prepack": "node scripts/shrinkwrap.ts && pnpm build && cp ../../LICENSE LICENSE",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --ignoreConfig --noEmit --strict --lib ES2024,DOM types/scene.d.ts && tsc --ignoreConfig --noEmit --strict --lib ES2024,WebWorker types/sound.d.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@animaquill/core": "workspace:*",
    "@animaquill/scene": "workspace:*",
    "@animaquill/schema": "workspace:*",
    "@animaquill/server": "workspace:*",
    "@animaquill/tools": "workspace:*",
    "@animaquill/web": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.0.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  }
}
