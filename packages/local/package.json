{
  "name": "animaquill",
  "version": "0.0.0",
  "description": "AnimaQuill 视频编辑器，在自己的电脑上用 Chrome 或 Edge 打开",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "animaquill": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "video-editor",
    "animation"
  ],
  "scripts": {
    "build": "vite build --config vite.server.config.ts && vite build",
    "start": "pnpm build && node dist/cli.js",
    "prepack": "pnpm build && cp ../../LICENSE LICENSE",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@animaquill/scene": "workspace:*",
    "@animaquill/web": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "26.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
