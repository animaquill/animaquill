{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "erasableSyntaxOnly": true
  },
  "include": ["src", "drizzle.config.ts", "vitest.config.ts"],
  // Runs the editor's sync against the server: the editor's code needs the types of a browser,
  // which nothing of the server may use, see tsconfig.editor.json.
  "exclude": ["src/sync/editors*.ts"]
}
