{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "libraries": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/__schema0" },
      "additionalProperties": { "$ref": "#/$defs/__schema1" }
    }
  },
  "required": ["libraries"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "__schema1": {
      "type": "object",
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/=_-]+$" }
      },
      "required": ["commit", "integrity"],
      "additionalProperties": false
    }
  }
}
