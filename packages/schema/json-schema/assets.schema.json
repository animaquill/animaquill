{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assets": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/__schema0" },
      "additionalProperties": { "$ref": "#/$defs/__schema1" }
    }
  },
  "required": ["assets"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "__schema1": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/__schema2" },
        "kind": { "$ref": "#/$defs/__schema3" },
        "path": { "$ref": "#/$defs/__schema4" },
        "storage": { "$ref": "#/$defs/__schema5" },
        "url": { "$ref": "#/$defs/__schema6" },
        "hash": { "$ref": "#/$defs/__schema7" },
        "size": { "$ref": "#/$defs/__schema8" },
        "info": { "$ref": "#/$defs/__schema9" },
        "license": { "$ref": "#/$defs/__schema10" },
        "credit": { "$ref": "#/$defs/__schema11" },
        "tags": { "$ref": "#/$defs/__schema12" }
      },
      "required": ["kind", "path", "storage"],
      "additionalProperties": false
    },
    "__schema2": { "type": "string" },
    "__schema3": {
      "type": "string",
      "enum": ["video", "audio", "image", "font", "model", "other"]
    },
    "__schema4": { "type": "string", "minLength": 1 },
    "__schema5": { "type": "string", "enum": ["git", "lfs", "local", "remote"] },
    "__schema6": { "type": "string", "pattern": "^https:\\/\\/\\S+$" },
    "__schema7": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/=_-]+$" },
    "__schema8": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "__schema9": {
      "type": "object",
      "properties": {
        "duration": { "type": "string", "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\d+\\/0*[1-9]\\d*)$" },
        "width": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "height": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "fps": { "type": "string", "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\d+\\/0*[1-9]\\d*)$" },
        "sampleRate": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "channels": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "hasAudio": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "__schema10": { "type": "string" },
    "__schema11": { "type": "string" },
    "__schema12": {
      "maxItems": 30,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema13" }
    },
    "__schema13": { "type": "string", "minLength": 1, "maxLength": 40 }
  }
}
