{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/__schema0" }
    }
  },
  "required": ["notes"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/__schema1" },
        "status": {
          "type": "string",
          "enum": ["pending", "working", "review", "done", "rejected"]
        },
        "text": { "type": "string" },
        "timeline": { "$ref": "#/$defs/__schema1" },
        "time": { "$ref": "#/$defs/__schema2" },
        "end": { "$ref": "#/$defs/__schema2" },
        "language": { "type": "string" },
        "format": { "type": "string" },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clip": { "$ref": "#/$defs/__schema1" },
              "path": { "type": "string", "minLength": 1 },
              "name": { "type": "string" }
            },
            "required": ["clip"],
            "additionalProperties": false
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "area" },
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "width": { "type": "number" },
                  "height": { "type": "number" }
                },
                "required": ["type", "x", "y", "width", "height"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "arrow" },
                  "from": { "$ref": "#/$defs/__schema3" },
                  "to": { "$ref": "#/$defs/__schema3" }
                },
                "required": ["type", "from", "to"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "stroke" },
                  "points": {
                    "minItems": 2,
                    "type": "array",
                    "items": { "$ref": "#/$defs/__schema3" }
                  }
                },
                "required": ["type", "points"],
                "additionalProperties": false
              }
            ]
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "from": { "$ref": "#/$defs/__schema4" },
              "to": { "$ref": "#/$defs/__schema4" }
            },
            "required": ["path", "to"],
            "additionalProperties": false
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["id", "status", "text", "timeline", "time", "createdAt"],
      "additionalProperties": false
    },
    "__schema1": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "__schema2": { "type": "string", "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\d+\\/0*[1-9]\\d*)$" },
    "__schema3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "__schema4": {
      "anyOf": [
        { "type": "number" },
        { "type": "string" },
        { "type": "boolean" },
        {
          "type": "array",
          "items": { "type": "number" }
        },
        {
          "type": "object",
          "properties": {
            "string": { "type": "string", "minLength": 1 }
          },
          "required": ["string"],
          "additionalProperties": false
        },
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "asset": { "$ref": "#/$defs/__schema1" }
              },
              "required": ["asset"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "library": { "$ref": "#/$defs/__schema1" },
                "path": { "type": "string", "minLength": 1 }
              },
              "required": ["library", "path"],
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
