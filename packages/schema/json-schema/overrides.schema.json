{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": { "$ref": "#/$defs/__schema0" },
    "sections": { "$ref": "#/$defs/__schema2" },
    "clips": { "$ref": "#/$defs/__schema6" }
  },
  "required": ["scope"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "format": { "$ref": "#/$defs/__schema1" }
      },
      "additionalProperties": false
    },
    "__schema1": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "__schema2": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/__schema1" },
      "additionalProperties": { "$ref": "#/$defs/__schema3" }
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/__schema4" },
            "base": { "$ref": "#/$defs/__schema4" }
          },
          "required": ["value"],
          "additionalProperties": false
        }
      },
      "required": ["duration"],
      "additionalProperties": false
    },
    "__schema4": { "$ref": "#/$defs/__schema5" },
    "__schema5": { "type": "string", "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\d+\\/0*[1-9]\\d*)$" },
    "__schema6": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/__schema1" },
      "additionalProperties": { "$ref": "#/$defs/__schema7" }
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "start": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/__schema8" },
            "base": { "$ref": "#/$defs/__schema8" }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "duration": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/__schema4" },
            "base": { "$ref": "#/$defs/__schema4" }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "offset": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/__schema8" },
            "base": { "$ref": "#/$defs/__schema8" }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "hidden": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/__schema9" },
            "base": { "$ref": "#/$defs/__schema9" }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/__schema10" },
            "base": { "$ref": "#/$defs/__schema10" }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "properties": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/__schema24" },
          "additionalProperties": { "$ref": "#/$defs/__schema25" }
        }
      },
      "additionalProperties": false
    },
    "__schema8": { "$ref": "#/$defs/__schema5" },
    "__schema9": { "type": "boolean" },
    "__schema10": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "video" },
                "media": { "$ref": "#/$defs/__schema11" }
              },
              "required": ["kind", "media"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "image" },
                "media": { "$ref": "#/$defs/__schema11" }
              },
              "required": ["kind", "media"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "audio" },
                "media": { "$ref": "#/$defs/__schema11" }
              },
              "required": ["kind", "media"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "$ref": "#/$defs/__schema12" },
                "scene": { "$ref": "#/$defs/__schema13" },
                "library": { "$ref": "#/$defs/__schema14" },
                "resource": { "$ref": "#/$defs/__schema15" }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "$ref": "#/$defs/__schema16" },
                "sound": { "$ref": "#/$defs/__schema17" },
                "library": { "$ref": "#/$defs/__schema18" },
                "resource": { "$ref": "#/$defs/__schema19" },
                "output": { "$ref": "#/$defs/__schema20" }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "music" },
                "music": { "$ref": "#/$defs/__schema1" }
              },
              "required": ["kind", "music"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "timeline" },
                "timeline": { "$ref": "#/$defs/__schema1" }
              },
              "required": ["kind", "timeline"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "color" },
                "color": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
              },
              "required": ["kind", "color"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "caption" },
                "text": {
                  "anyOf": [
                    { "type": "string" },
                    { "$ref": "#/$defs/__schema21" }
                  ]
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": { "type": "string" },
                      "time": { "$ref": "#/$defs/__schema8" }
                    },
                    "required": ["text", "time"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["kind", "text"],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": { "$ref": "#/$defs/__schema22" }
          },
          "required": ["kind"],
          "additionalProperties": { "$ref": "#/$defs/__schema23" }
        }
      ]
    },
    "__schema11": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "asset": { "$ref": "#/$defs/__schema1" }
          },
          "required": ["asset"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "library": { "$ref": "#/$defs/__schema1" },
            "path": { "type": "string", "minLength": 1 }
          },
          "required": ["library", "path"],
          "additionalProperties": false
        }
      ]
    },
    "__schema12": { "type": "string", "const": "scene" },
    "__schema13": { "$ref": "#/$defs/__schema1" },
    "__schema14": { "$ref": "#/$defs/__schema1" },
    "__schema15": { "$ref": "#/$defs/__schema1" },
    "__schema16": { "type": "string", "const": "sound" },
    "__schema17": { "$ref": "#/$defs/__schema1" },
    "__schema18": { "$ref": "#/$defs/__schema1" },
    "__schema19": { "$ref": "#/$defs/__schema1" },
    "__schema20": { "type": "string", "minLength": 1 },
    "__schema21": {
      "type": "object",
      "properties": {
        "string": { "type": "string", "minLength": 1 }
      },
      "required": ["string"],
      "additionalProperties": false
    },
    "__schema22": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
    "__schema23": {},
    "__schema24": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype)(?:\\.|$))[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.(?!(?:constructor|prototype)(?:\\.|$))[A-Za-z0-9][A-Za-z0-9_-]*)*$"
    },
    "__schema25": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/__schema26" },
        "base": { "$ref": "#/$defs/__schema26" }
      },
      "required": ["value"],
      "additionalProperties": false
    },
    "__schema26": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "keys": { "$ref": "#/$defs/__schema27" },
            "before": { "$ref": "#/$defs/__schema37" },
            "after": { "$ref": "#/$defs/__schema39" },
            "modifiers": { "$ref": "#/$defs/__schema40" }
          },
          "required": ["keys"],
          "additionalProperties": false
        },
        { "$ref": "#/$defs/__schema29" }
      ]
    },
    "__schema27": {
      "minItems": 1,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema28" }
    },
    "__schema28": {
      "type": "object",
      "properties": {
        "time": { "$ref": "#/$defs/__schema8" },
        "value": { "$ref": "#/$defs/__schema29" },
        "interp": { "$ref": "#/$defs/__schema30" },
        "out": { "$ref": "#/$defs/__schema31" },
        "in": { "$ref": "#/$defs/__schema33" },
        "tangent": { "$ref": "#/$defs/__schema34" },
        "preset": { "$ref": "#/$defs/__schema35" },
        "spring": { "$ref": "#/$defs/__schema36" }
      },
      "required": ["time", "value"],
      "additionalProperties": false
    },
    "__schema29": {
      "anyOf": [
        { "type": "number" },
        { "type": "string" },
        { "type": "boolean" },
        {
          "type": "array",
          "items": { "type": "number" }
        },
        { "$ref": "#/$defs/__schema21" },
        { "$ref": "#/$defs/__schema11" }
      ]
    },
    "__schema30": { "type": "string", "enum": ["linear", "bezier", "hold", "spring", "preset"] },
    "__schema31": { "$ref": "#/$defs/__schema32" },
    "__schema32": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "__schema33": { "$ref": "#/$defs/__schema32" },
    "__schema34": { "type": "string", "enum": ["auto", "aligned", "broken"] },
    "__schema35": { "type": "string", "minLength": 1 },
    "__schema36": {
      "type": "object",
      "properties": {
        "stiffness": { "type": "number", "exclusiveMinimum": 0 },
        "damping": { "type": "number", "minimum": 0 },
        "mass": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["stiffness", "damping"],
      "additionalProperties": false
    },
    "__schema37": { "$ref": "#/$defs/__schema38" },
    "__schema38": { "type": "string", "enum": ["hold", "loop", "pingpong", "continue"] },
    "__schema39": { "$ref": "#/$defs/__schema38" },
    "__schema40": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "const": "noise" },
          "amount": { "type": "number" },
          "frequency": { "type": "number", "exclusiveMinimum": 0 },
          "seed": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
        },
        "required": ["type", "amount", "seed"],
        "additionalProperties": false
      }
    }
  }
}
