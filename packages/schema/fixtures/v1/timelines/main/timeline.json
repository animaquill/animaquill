{
  "name": "主线",
  "background": "#101418",
  "sections": [
    { "id": "section_intro", "name": "片头", "duration": "5" },
    { "id": "section_body", "name": "讲解", "duration": "20" },
    { "id": "section_end", "name": "结尾", "duration": "5.005" }
  ],
  "markers": [
    { "id": "marker_hook", "time": "0.342", "name": "钩子", "note": "第一句话抓住观众", "color": "#ff6b8a" },
    { "id": "marker_turn", "time": "5", "name": "转折", "duration": "2" }
  ],
  "beatGrid": {
    "segments": [
      { "start": "0", "bpm": 120, "meter": [4, 4] },
      { "start": "16", "bpm": 90, "meter": [3, 4], "downbeat": "16.5" }
    ]
  },
  "tracks": [
    {
      "id": "track_video",
      "name": "画面",
      "kind": "video",
      "clips": [
        {
          "id": "clip_title",
          "name": "标题",
          "start": "0",
          "duration": "5",
          "source": { "kind": "scene", "scene": "title" },
          "fadeOut": "0.5",
          "sectionFit": "stretch",
          "properties": {
            "opacity": {
              "keys": [
                { "time": "0", "value": 0, "interp": "bezier", "out": [0.42, 0] },
                { "time": "1/3", "value": 1, "in": [0.58, 1], "tangent": "aligned" },
                { "time": "4", "value": 1, "interp": "hold" }
              ],
              "after": "hold"
            },
            "param.accent": "#ffc371",
            "param.size": 64,
            "param.title": { "string": "intro.title" },
            "transform.x": {
              "keys": [
                {
                  "time": "0",
                  "value": 0,
                  "interp": "spring",
                  "spring": { "stiffness": 180, "damping": 12 }
                },
                { "time": "2", "value": 192, "interp": "preset", "preset": "back-out" },
                { "time": "3", "value": 0 }
              ],
              "before": "hold",
              "after": "pingpong",
              "modifiers": [
                { "type": "noise", "amount": 19.2, "frequency": 3, "seed": 7 }
              ]
            }
          }
        },
        {
          "id": "clip_interview",
          "name": "采访",
          "start": "5",
          "duration": "12.5",
          "source": {
            "kind": "video",
            "media": { "asset": "interview" }
          },
          "offset": "1.5",
          "link": "link_interview",
          "sectionFit": "hold",
          "properties": {
            "crop.left": 0.1,
            "fit": "cover",
            "time.speed": {
              "keys": [
                { "time": "0", "value": 1 },
                { "time": "6", "value": 0.5 }
              ]
            }
          },
          "effects": [
            {
              "id": "fx_blur",
              "type": "blur",
              "properties": {
                "radius": {
                  "keys": [
                    { "time": "0", "value": 0 },
                    { "time": "1", "value": 12 }
                  ]
                }
              }
            },
            {
              "id": "fx_grade",
              "type": "plugin.film-grade",
              "enabled": false,
              "properties": { "strength": 0.4 }
            }
          ]
        },
        {
          "id": "clip_logo",
          "start": "17.5",
          "duration": "7.5",
          "source": {
            "kind": "image",
            "media": { "library": "lib_7f3a", "path": "assets/logo.png" }
          },
          "properties": {
            "blend": "screen",
            "transform.width": 192,
            "transform.x": 768,
            "transform.y": -432
          }
        },
        {
          "id": "clip_card",
          "start": "25",
          "duration": "5.005",
          "source": { "kind": "scene", "library": "lib_7f3a", "resource": "title-card" }
        }
      ],
      "transitions": [
        {
          "id": "tr_1",
          "type": "dissolve",
          "from": "clip_title",
          "to": "clip_interview",
          "duration": "0.5"
        },
        {
          "id": "tr_2",
          "type": "plugin.wipe-star",
          "to": "clip_card",
          "duration": "1/3",
          "properties": { "softness": 0.2 }
        }
      ]
    },
    {
      "id": "track_overlay",
      "name": "叠加",
      "locked": true,
      "group": "画面组",
      "kind": "video",
      "hidden": false,
      "clips": [
        {
          "id": "clip_lottie",
          "start": "6",
          "duration": "4",
          "source": {
            "kind": "plugin.lottie",
            "loops": 3,
            "src": { "asset": "logo" }
          },
          "loop": true
        },
        {
          "id": "clip_idea",
          "name": "样片：换个开场",
          "start": "10",
          "duration": "2",
          "source": { "kind": "color", "color": "#000000" },
          "hidden": true,
          "draft": true
        }
      ]
    },
    {
      "id": "track_voice",
      "name": "配音",
      "kind": "audio",
      "role": "voice",
      "clips": [
        {
          "id": "clip_voice",
          "start": "0",
          "duration": "20",
          "source": {
            "kind": "audio",
            "media": { "asset": "narration-zh" }
          },
          "properties": { "audio.volume": -3 }
        },
        {
          "id": "clip_interview_audio",
          "start": "20",
          "duration": "5",
          "source": {
            "kind": "audio",
            "media": { "asset": "studio-loop" }
          },
          "fadeIn": "0.2",
          "fadeOut": "0.2",
          "link": "link_interview",
          "properties": { "audio.pan": -0.2, "audio.pitch": 2, "audio.preservePitch": true }
        }
      ],
      "properties": { "audio.volume": -1 }
    },
    {
      "id": "track_music",
      "name": "音乐",
      "kind": "audio",
      "role": "music",
      "muted": false,
      "solo": false,
      "clips": [
        {
          "id": "clip_hit",
          "start": "5",
          "duration": "1",
          "source": { "kind": "sound", "sound": "impacts", "output": "hit" },
          "sectionFit": "span"
        },
        {
          "id": "clip_bed",
          "start": "6",
          "duration": "24",
          "source": {
            "kind": "audio",
            "media": { "library": "lib_7f3a", "path": "music/bed.flac" }
          },
          "loop": true,
          "properties": {
            "audio.volume": {
              "keys": [
                { "time": "0", "value": -12 },
                { "time": "20", "value": -30 }
              ]
            }
          }
        }
      ],
      "effects": [
        {
          "id": "fx_duck",
          "type": "duck",
          "properties": { "amount": 0.75, "attack": 0.02, "release": 0.3, "track": "track_voice" }
        }
      ],
      "sends": [
        {
          "bus": "bus_room",
          "properties": { "audio.volume": -12 }
        }
      ],
      "output": "bus_music"
    },
    {
      "id": "track_captions",
      "name": "字幕",
      "kind": "caption",
      "clips": [
        {
          "id": "clip_line",
          "start": "5",
          "duration": "3",
          "source": {
            "kind": "caption",
            "text": { "string": "subtitle.one" },
            "words": [
              { "text": "一切", "time": "0" },
              { "text": "物质", "time": "0.8" }
            ]
          },
          "properties": { "caption.size": 48 }
        }
      ]
    }
  ],
  "mix": {
    "buses": [
      {
        "id": "bus_music",
        "name": "音乐总线",
        "properties": { "audio.volume": -6 }
      },
      {
        "id": "bus_room",
        "name": "房间混响",
        "effects": [
          {
            "id": "fx_room",
            "type": "reverb",
            "properties": { "mix": 0.3, "seconds": 1.8, "seed": 3 }
          }
        ],
        "output": "bus_music"
      }
    ],
    "master": {
      "effects": [
        {
          "id": "fx_limit",
          "type": "limiter",
          "properties": { "ceiling": -1, "release": 0.1 }
        }
      ]
    }
  }
}
